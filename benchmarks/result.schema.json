{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manu080797/llm2jev-research/benchmarks/result.schema.json",
  "title": "LLM2Jev early comparative result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "workload",
    "system",
    "scorer",
    "aggregate",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "experiment_id": {
      "type": "string",
      "minLength": 1
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "model",
        "training_exposure",
        "runtime",
        "device_mode"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "model_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "training_exposure": {
          "enum": [
            "zero-training",
            "general-trained-specialist",
            "task-finetuned-specialist",
            "unknown"
          ]
        },
        "quantization": {
          "type": [
            "string",
            "null"
          ]
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "runtime_revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "device_mode": {
          "enum": [
            "cpu",
            "gpu",
            "hybrid",
            "unknown"
          ]
        },
        "hardware": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "scorer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parameters"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "case_count",
        "elapsed_seconds"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 1
        },
        "correct_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "accuracy": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "elapsed_seconds": {
          "type": "number",
          "minimum": 0
        },
        "requests_per_second": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_rss_mb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "peak_vram_mb": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "energy_joules": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "latency_ms",
          "prediction",
          "correct"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0
          },
          "prediction": {},
          "correct": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "response": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  }
}
